# ==============================================================================
# DAIRYTRACK ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Duplicate this file as .env and fill in your actual production values.
# NEVER commit real credentials, service-role keys, or JWT secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. CORS & CLIENT DOMAINS
# Comma-separated list of allowed origins (e.g. production Vercel frontend)
# ------------------------------------------------------------------------------
CLIENT_ORIGIN=https://dairytrack.vercel.app,http://localhost:5173,http://localhost:3000
API_BASE_URL=https://api.dairytrack.com

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL & AUTHENTICATION
# Found in Supabase Dashboard -> Project Settings -> API & Database
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Public anon key (Safe for client-side queries protected by RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
# Service-Role key (STRICTLY SERVER-SIDE ONLY - Bypasses RLS for admin triggers)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder
# Direct PostgreSQL connection pooler (Session / Transaction pooler string)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# 4. JWT & AUTHENTICATION REDIRECTS
# Generate a secure 256-bit secret using: openssl rand -base64 48
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_base64_string
JWT_EXPIRES_IN=7d
AUTH_REDIRECT_URL=https://dairytrack.vercel.app/login

# ------------------------------------------------------------------------------
# 5. SECURITY & OWASP RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
COOKIE_SECURE=true
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 6. LOCAL SQLITE CACHE & PHYSICAL BACKUP CONFIGURATION
# ------------------------------------------------------------------------------
DATABASE_PATH=./dairytrack.db
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_CRON=0 2 * * *

# ------------------------------------------------------------------------------
# 7. LOGGING, MONITORING & AUDIT TRAIL
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_AUDIT_LOG=true
SENTRY_DSN=
