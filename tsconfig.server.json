{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/server.ts",
    "src/controllers/**/*",
    "src/services/*.service.ts",
    "src/database/**/*",
    "src/middleware/**/*",
    "src/validators/**/*",
    "src/utilities/**/*",
    "src/config/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scratch",
    "public",
    "src/components",
    "src/pages",
    "src/context",
    "src/hooks",
    "src/routes",
    "src/styles",
    "src/App.tsx",
    "src/main.tsx"
  ]
}
